    {
        "id": "func_mes_simul",
        "type": "function",
        "z": "tab_mes_simul",
        "name": "PLC / MES Part Number Generator",
        "func": "const parts = [\n  { part_number: 'PN-1001-STEEL', batch_id: 'LOT-2026-01' },\n  { part_number: 'PN-2002-ALUM', batch_id: 'LOT-2026-02' },\n  { part_number: 'PN-3003-TITANIUM', batch_id: 'LOT-2026-03' }\n];\n\nlet selected;\nif (msg.payload === 'AUTO') {\n  let idx = context.get('part_idx') || 0;\n  selected = parts[idx % parts.length];\n  context.set('part_idx', (idx + 1) % parts.length);\n} else {\n  selected = parts.find(p => p.part_number === msg.payload) || { part_number: String(msg.payload), batch_id: 'LOT-MANUAL' };\n}\n\nconst outTopic = 'enterprise/plant/area/sub-area/cell/mes/state/';\nmsg.topic = outTopic;\nmsg.payload = {\n  source: 'MES_Simul',\n  plc_id: 'plc_cell_1',\n  event: 'PRODUCTION_STARTED',\n  part_number: selected.part_number,\n  batch_id: selected.batch_id,\n  timestamp: new Date().toISOString(),\n  topic: outTopic\n};\n\nnode.status({ fill: 'blue', shape: 'dot', text: 'Producing: ' + selected.part_number + ' (' + selected.batch_id + ')' });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 180,
        "wires": [
