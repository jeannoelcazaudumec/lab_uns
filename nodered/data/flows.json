    {
        "id": "func_opcua1",
        "type": "function",
        "z": "tab_opcua1",
        "name": "Format Asset 3 Telemetry",
        "func": "const topic = msg.topic || \"\";\nif (topic.includes(\"Temperature\")) {\n    context.set(\"temperature\", Number(Number(msg.payload).toFixed(2)));\n} else if (topic.includes(\"Humidity\")) {\n    context.set(\"humidity\", Number(Number(msg.payload).toFixed(2)));\n} else if (topic.includes(\"MotorSpeed\")) {\n    context.set(\"motor_speed\", Number(Number(msg.payload).toFixed(1)));\n}\n\nconst temp = context.get(\"temperature\");\nconst hum = context.get(\"humidity\");\nconst speed = context.get(\"motor_speed\");\n\nif (topic.includes(\"MotorSpeed\") && temp !== undefined && hum !== undefined && speed !== undefined) {\n    const outTopic = \"enterprise/plant/area/sub-area/cell/asset_3/raw/\";\n    msg.topic = outTopic;\n    msg.payload = {\n        asset_id: \"asset_3\",\n        device: \"opcua1\",\n        protocol: \"opc-ua\",\n        temperature: temp,\n        humidity: hum,\n        motor_speed: speed,\n        timestamp: new Date().toISOString(),\n        topic: outTopic\n    };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 140,
        "wires": [
            [
                "debug_opcua1",
                "mqtt_out_opcua1"
            ]
