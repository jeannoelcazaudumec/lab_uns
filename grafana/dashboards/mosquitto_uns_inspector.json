          "rawSql": "SELECT client_id AS \"Client ID\", status AS \"Status\", role AS \"Architectural Role\", network_zone AS \"Network Zone\", ip_address AS \"Client IP\", mqtt_version AS \"Protocol\", CASE WHEN clean_start THEN 'Volatile (clean=true)' ELSE 'Persistent (clean=false)' END AS \"Session Mode\", max_queue_size AS \"Max Queue (Msgs)\", subscriptions_count AS \"Subs\", messages_in AS \"Msgs Published (In)\", messages_out AS \"Msgs Delivered (Out)\", published_topics AS \"Published UNS Topics\", last_seen AS \"Last Activity\" FROM uns_clients ORDER BY clean_start ASC, client_id ASC;",
          "refId": "A"
