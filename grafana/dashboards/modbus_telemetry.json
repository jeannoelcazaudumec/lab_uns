          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", (payload->>'temperature')::double precision AS \"value\", payload->>'asset_id' AS \"metric\" FROM asset_telemetry WHERE $__timeFilter(time) ORDER BY 1;",
